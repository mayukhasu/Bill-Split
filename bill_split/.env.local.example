# Copy this file to .env.local and fill in real values (never commit .env.local itself).
#
# All of these are NEXT_PUBLIC_* vars, which Next.js inlines at BUILD time — so when
# deploying, set them in Vercel's Project Settings *before* the build that ships them,
# not just in this local file. (Same rule already applies to NEXT_PUBLIC_BACKEND_URL.)

# From Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Also from Project Settings -> API. Supabase is mid-migration from "anon"/"service_role"
# naming to "publishable"/"secret" -- use whichever label your dashboard actually shows;
# functionally identical either way.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Base URL used to construct the OAuth redirect deterministically.
# Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (set this instead in Vercel's env vars once you have the deployed URL):
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Existing, unrelated to Supabase -- the separate FastAPI/OCR backend's URL.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5001
